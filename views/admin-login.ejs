<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Login - Live Chat</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    :root {
      --primary: #0ea5e9;
      --primary-dark: #0284c7;
      --primary-light: #e0f2fe;
      --bg: #f8fafc;
      --surface: #ffffff;
      --text: #0f172a;
      --subtle: #64748b;
      --border: rgba(0, 0, 0, 0.1);
    }
    body { background: var(--bg); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
    .login-card { background: var(--surface); border-radius: 12px; padding: 32px; width: 100%; max-width: 340px; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1); border: 1px solid var(--border); }
    .login-card h2 { color: var(--primary); text-align: center; margin-bottom: 5px; font-weight: 700; }
    .login-card .subtitle { color: var(--subtle); text-align: center; font-size: 13px; margin-bottom: 25px; }
    .form-control { background: var(--surface); border: 1px solid var(--border); color: var(--text); padding: 12px; }
    .form-control:focus { background: var(--surface); color: var(--text); border-color: var(--primary); box-shadow: none; }
    .password-wrap { position: relative; }
    .password-wrap .form-control { padding-right: 44px; }
    .pw-toggle {
      position: absolute; right: 4px; top: 50%; transform: translateY(-50%);
      width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;
      border: none; background: transparent; color: var(--subtle); cursor: pointer; border-radius: 8px;
    }
    .pw-toggle:hover { color: var(--primary); }
    .pw-toggle svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .form-label { color: var(--text); font-size: 14px; }
    .btn-login { background: var(--primary); border: none; padding: 12px; font-weight: 600; width: 100%; margin-top: 10px; }
    .btn-login:hover { background: var(--primary-dark); }
    .alert { font-size: 14px; }
  </style>
</head>
<body>
  <div class="login-card">
    <h2>ADMIN PANEL</h2>
    <p class="subtitle">Login Admin Rumah Sakit</p>
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <% if (typeof info !== 'undefined' && info) { %>
      <div class="alert alert-success"><%= info %></div>
    <% } %>
    <form method="POST" action="/admin/login">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" name="email" class="form-control" placeholder="Masukkan email admin" autocomplete="email" required autofocus />
      </div>
      <div class="mb-3">
        <label class="form-label">Password</label>
        <div class="password-wrap">
          <input type="password" name="password" class="form-control" id="passwordInput" placeholder="Masukkan password" autocomplete="current-password" required />
          <button type="button" class="pw-toggle" id="pwToggle" aria-label="Lihat password" tabindex="-1">
            <svg id="pwIconEye" viewBox="0 0 24 24"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg>
            <svg id="pwIconEyeOff" viewBox="0 0 24 24" hidden><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path><path d="m2 2 20 20"></path></svg>
          </button>
        </div>
      </div>
      <button type="submit" class="btn btn-login">MASUK</button>
    </form>
    <a href="/admin/forgot-password" style="display:block;text-align:center;margin-top:16px;font-size:13px">Lupa password?</a>
  </div>
  <script>
    var pwInput = document.getElementById('passwordInput');
    var pwToggle = document.getElementById('pwToggle');
    var iconEye = document.getElementById('pwIconEye');
    var iconEyeOff = document.getElementById('pwIconEyeOff');
    pwToggle.addEventListener('click', function () {
      var show = pwInput.type === 'password';
      pwInput.type = show ? 'text' : 'password';
      iconEye.hidden = show;
      iconEyeOff.hidden = !show;
      pwToggle.setAttribute('aria-label', show ? 'Sembunyikan password' : 'Lihat password');
    });
  </script>
</body>
</html>
