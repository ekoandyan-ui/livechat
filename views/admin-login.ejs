<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Login - Live Chat</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    :root {
      --primary: #0ea5e9;
      --primary-dark: #0284c7;
      --primary-light: #e0f2fe;
      --bg: #f8fafc;
      --surface: #ffffff;
      --text: #0f172a;
      --subtle: #64748b;
      --border: rgba(0, 0, 0, 0.1);
    }
    body { background: var(--bg); min-height: 100vh; display: flex; align-items: center; justify-content: center; }
    .login-card { background: var(--surface); border-radius: 12px; padding: 40px; width: 100%; max-width: 400px; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1); border: 1px solid var(--border); }
    .login-card h2 { color: var(--primary); text-align: center; margin-bottom: 5px; font-weight: 700; }
    .login-card .subtitle { color: var(--subtle); text-align: center; font-size: 13px; margin-bottom: 25px; }
    .form-control { background: var(--surface); border: 1px solid var(--border); color: var(--text); padding: 12px; }
    .form-control:focus { background: var(--surface); color: var(--text); border-color: var(--primary); box-shadow: none; }
    .form-label { color: var(--text); font-size: 14px; }
    .btn-login { background: var(--primary); border: none; padding: 12px; font-weight: 600; width: 100%; margin-top: 10px; }
    .btn-login:hover { background: var(--primary-dark); }
    .alert { font-size: 14px; }
    .back-link { text-align: center; margin-top: 15px; }
    .back-link a { color: var(--subtle); text-decoration: none; font-size: 13px; }
    .back-link a:hover { color: var(--primary); }
  </style>
</head>
<body>
  <div class="login-card">
    <h2>ADMIN PANEL</h2>
    <p class="subtitle">Login Admin Rumah Sakit</p>
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <form method="POST" action="/admin/login">
      <div class="mb-3">
        <label class="form-label">Username</label>
        <input type="text" name="username" class="form-control" placeholder="Masukkan username" required autofocus />
      </div>
      <div class="mb-3">
        <label class="form-label">Password</label>
        <input type="password" name="password" class="form-control" placeholder="Masukkan password" required />
      </div>
      <button type="submit" class="btn btn-login">MASUK</button>
    </form>
    <div class="back-link">
      <a href="/">&larr; Kembali ke Halaman Utama</a>
    </div>
  </div>
</body>
</html>
