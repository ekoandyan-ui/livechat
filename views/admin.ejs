<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard - Live Chat</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    :root {
      --primary: #0ea5e9;
      --primary-dark: #0284c7;
      --primary-light: #e0f2fe;
      --bg: #f8fafc;
      --surface: #ffffff;
      --text: #0f172a;
      --subtle: #64748b;
      --border: rgba(0, 0, 0, 0.1);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: var(--bg); color: var(--text); font-family: 'Segoe UI', sans-serif; }
    .sidebar { width: 340px; min-height: 100vh; background: var(--surface); border-right: 1px solid var(--border); position: fixed; left: 0; top: 0; display: flex; flex-direction: column; }
    .sidebar-header { padding: 20px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; }
    .sidebar-header h4 { color: var(--primary); font-weight: 700; margin: 0; font-size: 18px; }
    .sidebar-header .hospital-badge { background: var(--primary-light); color: var(--primary); font-size: 11px; padding: 4px 10px; border-radius: 8px; font-weight: 600; width: 100%; text-align: center; }
    .sidebar-header a { color: var(--subtle); text-decoration: none; font-size: 13px; }
    .sidebar-header a:hover { color: var(--primary); }
    .room-list { flex: 1; overflow-y: auto; padding: 10px; }
    .room-item { padding: 15px; margin-bottom: 8px; background: var(--bg); border-radius: 10px; cursor: pointer; transition: all 0.2s; text-decoration: none; color: var(--text); display: block; border: 1px solid var(--border); }
    .room-item:hover { background: var(--primary-light); border-left: 3px solid var(--primary); }
    .room-item .room-name { font-weight: 600; font-size: 15px; }
    .room-item .last-msg { color: var(--subtle); font-size: 12px; margin-top: 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .main-content { margin-left: 340px; padding: 30px; min-height: 100vh; }
    .welcome-box { background: var(--surface); border-radius: 12px; padding: 40px; text-align: center; border: 1px solid var(--border); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05); }
    .welcome-box h2 { color: var(--primary); margin-bottom: 8px; }
    .welcome-box .hospital-name { color: var(--subtle); font-size: 16px; margin-bottom: 15px; }
    .welcome-box p { color: var(--subtle); }
    .stats { display: flex; gap: 20px; margin-top: 30px; justify-content: center; flex-wrap: wrap; }
    .stat-card { background: var(--bg); border-radius: 10px; padding: 20px 30px; text-align: center; border: 1px solid var(--border); }
    .stat-card .stat-num { font-size: 36px; font-weight: 700; color: var(--primary); }
    .stat-card .stat-label { color: var(--subtle); font-size: 13px; margin-top: 5px; }

    @media (max-width: 992px) {
      .sidebar { width: 300px; }
      .main-content { margin-left: 300px; padding: 20px; }
      .welcome-box { padding: 30px; }
      .stat-card { padding: 15px 22px; }
    }

    @media (max-width: 768px) {
      .sidebar { width: 260px; }
      .main-content { margin-left: 260px; padding: 15px; }
      .stats { flex-direction: column; align-items: center; gap: 12px; }
      .stat-card { width: 100%; max-width: 260px; }
      .welcome-box h2 { font-size: 20px; }
    }

    @media (max-width: 576px) {
      .sidebar { width: 100%; position: static; min-height: 100vh; border-right: none; }
      .main-content { display: none; }
      .sidebar-header h4 { font-size: 16px; }
      .sidebar-header { padding: 15px; }
      .room-list { padding: 8px; }
      .room-item { padding: 13px; }
    }
  </style>
</head>
<body>
  <div class="sidebar">
    <div class="sidebar-header">
      <h4>CHAT ROOMS</h4>
      <div class="hospital-badge"><%= adminRumahSakit %></div>
      <a href="/admin/logout">Logout</a>
    </div>
    <div class="room-list">
      <% rooms.forEach(room => { %>
        <a href="/admin/room/<%= room.id %>" class="room-item">
          <div class="room-name"><%= room.nama %></div>
          <% if (room.lastMessage) { %>
            <div class="last-msg"><%= room.lastMessage.sender_name %>: <%= room.lastMessage.message %></div>
          <% } else { %>
            <div class="last-msg">Belum ada pesan</div>
          <% } %>
        </a>
      <% }) %>
      <% if (rooms.length === 0) { %>
        <div style="text-align:center;color:var(--subtle);padding:40px 20px;font-size:14px;">
          Belum ada pasien di rumah sakit ini
        </div>
      <% } %>
    </div>
  </div>

  <div class="main-content">
    <div class="welcome-box">
      <h2>SELAMAT DATANG, <%= adminUser.toUpperCase() %></h2>
      <div class="hospital-name"><%= adminRumahSakit %></div>
      <p>Klik salah room di sidebar untuk melihat dan mengirim pesan</p>
      <div class="stats">
        <div class="stat-card">
          <div class="stat-num"><%= rooms.length %></div>
          <div class="stat-label">Total Pasien</div>
        </div>
        <div class="stat-card">
          <div class="stat-num"><%= rooms.reduce((a, b) => a + b.totalPesan, 0) %></div>
          <div class="stat-label">Total Pesan</div>
        </div>
      </div>
    </div>
  </div>

  <script>
    setInterval(() => location.reload(), 30000);
  </script>
</body>
</html>
