  const grid = document.getElementById('ctEmojiGrid');
  const searchInput = document.getElementById('ctEmojiSearch');
  const tabsContainer = document.getElementById('ctEmojiTabs');
  let activeCat = 'all';
  let searchQuery = '';

  function renderEmojis() {
    grid.innerHTML = '';
    const q = searchQuery.toLowerCase().trim();
    const filtered = EMOJI_DATA.filter(function (item) {
      const matchCat = activeCat === 'all' || item.c === activeCat;
      const matchSearch = !q || item.e.includes(q) || item.k.toLowerCase().includes(q);
      return matchCat && matchSearch;
    });

    if (filtered.length === 0) {
      grid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:24px 10px;font-size:12.5px;color:var(--subtle);">Emoji tidak ditemukan</div>';
      return;
    }

    filtered.forEach(function (item) {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = item.e;
      b.title = item.k.split(' ')[0];
      b.onclick = function () {
        msgInput.value += item.e;
        hide(emojiPanel);
        emojiBtn.classList.remove('active');
        msgInput.focus();
      };
      grid.appendChild(b);
    });
  }

  if (searchInput) {
    searchInput.addEventListener('input', function () {
      searchQuery = searchInput.value;
      renderEmojis();
    });
  }

  if (tabsContainer) {
    tabsContainer.addEventListener('click', function (e) {
      const tab = e.target.closest('.ct-emoji-tab');
      if (!tab) return;
      tabsContainer.querySelectorAll('.ct-emoji-tab').forEach(function (t) { t.classList.remove('active'); });
      tab.classList.add('active');
      activeCat = tab.getAttribute('data-cat') || 'all';
      renderEmojis();
    });
  }

  emojiBtn.addEventListener('click', function (e) {
    e.stopPropagation();
    hide(attachPanel);
    attachBtn.classList.remove('active');

    if (isMobile) {
      hide(emojiPanel);
      emojiBtn.classList.remove('active');
      emojiInput.value = '';
      emojiInput.focus();
    } else {
      emojiPanel.hidden = !emojiPanel.hidden;
      emojiBtn.classList.toggle('active', !emojiPanel.hidden);
      if (!emojiPanel.hidden) {
        renderEmojis();
        msgInput.focus();
      }
    }
  });

  emojiInput.addEventListener('input', function () {
    if (emojiInput.value) {
      msgInput.value += emojiInput.value;
      emojiInput.value = '';
      msgInput.focus();
    }
  });
  emojiInput.addEventListener('blur', function () { emojiInput.value = ''; });

  // ---------- Panel lampiran ----------
  attachBtn.addEventListener('click', function (e) {
    e.stopPropagation();
    hide(emojiPanel);
    emojiBtn.classList.remove('active');

    attachPanel.hidden = !attachPanel.hidden;
    attachBtn.classList.toggle('active', !attachPanel.hidden);
  });

  attachPanel.addEventListener('click', function (e) {
    const btn = e.target.closest('button[data-action]');
    if (!btn) return;
    hide(attachPanel);
    attachBtn.classList.remove('active');

    const action = btn.getAttribute('data-action');
    if (action === 'camera') openCamera();
    else if (action === 'gallery') {
      const input = document.getElementById('ctFileGallery');
      if (input) input.click();
    } else if (action === 'doc') {
      const input = document.getElementById('ctFileDoc');
      if (input) input.click();
    }
  });

  // Tutup panel ketika klik di luar
  document.addEventListener('click', function (e) {
    if (!composer.contains(e.target) && !attachPanel.contains(e.target) && !emojiPanel.contains(e.target)) {
      hide(attachPanel);
      hide(emojiPanel);
      attachBtn.classList.remove('active');
      emojiBtn.classList.remove('active');
    }
  });

  ['ctFileCamera', 'ctFileGallery', 'ctFileDoc'].forEach(function (id) {
    const input = document.getElementById(id);
    if (!input) return;
    input.addEventListener('change', function () {
      const file = input.files && input.files[0];
      input.value = '';
      if (file) uploadFile(file);
    });
  });

  // ---------- Kamera (akses kamera langsung dari device) ----------
  let cameraStream = null;
  let cameraFacing = 'environment';

  function stopCamera() {
    if (cameraStream) {
      cameraStream.getTracks().forEach(function (t) { t.stop(); });
      cameraStream = null;
    }
    if (cameraVideo) cameraVideo.srcObject = null;
  }

  function startCamera() {
    stopCamera();
    return navigator.mediaDevices.getUserMedia({
      video: { facingMode: cameraFacing, width: { ideal: 1920 }, height: { ideal: 1920 } },
      audio: false
    }).then(function (stream) {
      cameraStream = stream;
      cameraVideo.srcObject = stream;
      show(cameraModal);
      cameraVideo.play().catch(function () {});
    });
  }

  function openCamera() {
    hide(attachPanel);
    attachBtn.classList.remove('active');
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      fallbackCamera();
      return;
    }
    startCamera().catch(function () { fallbackCamera(); });
  }

  function fallbackCamera() {
    const input = document.getElementById('ctFileCamera');
    if (input) input.click();
  }

  document.getElementById('ctCameraCapture').addEventListener('click', function () {
    if (!cameraVideo || !cameraVideo.videoWidth) return;
    const canvas = document.createElement('canvas');
    canvas.width = cameraVideo.videoWidth;
    canvas.height = cameraVideo.videoHeight;
    canvas.getContext('2d').drawImage(cameraVideo, 0, 0);
    stopCamera();
    hide(cameraModal);
    canvas.toBlob(function (blob) {
      if (blob) {
        const file = new File([blob], 'kamera_' + Date.now() + '.jpg', { type: 'image/jpeg' });
        uploadFile(file);
      }
    }, 'image/jpeg', 0.92);
  });

  document.getElementById('ctCameraSwitch').addEventListener('click', function () {
    cameraFacing = cameraFacing === 'environment' ? 'user' : 'environment';
    startCamera().catch(function () { fallbackCamera(); });
  });

  document.getElementById('ctCameraClose').addEventListener('click', function () {
    stopCamera();
    hide(cameraModal);
  });

  // ---------- Kompresi ----------
  function compressImageFile(file) {
    return new Promise(function (resolve) {
      const MAX = 1280;
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = function () {
        let w = img.naturalWidth, h = img.naturalHeight;
        if (!w || !h) { URL.revokeObjectURL(url); resolve(file); return; }
        const r = Math.min(1, MAX / Math.max(w, h));
        w = Math.max(1, Math.round(w * r));
        h = Math.max(1, Math.round(h * r));
        const canvas = document.createElement('canvas');
        canvas.width = w; canvas.height = h;
        canvas.getContext('2d').drawImage(img, 0, 0, w, h);
        URL.revokeObjectURL(url);
        canvas.toBlob(function (blob) {
          if (blob && blob.size < file.size) resolve(blob);
          else resolve(file);
        }, 'image/jpeg', 0.72);
      };
      img.onerror = function () { URL.revokeObjectURL(url); resolve(file); };
      img.src = url;
    });
  }

  function compressVideoFile(file) {
    return new Promise(function (resolve) {
      const canReencode = typeof MediaRecorder !== 'undefined' &&
        typeof HTMLCanvasElement !== 'undefined' &&
        typeof HTMLCanvasElement.prototype.captureStream === 'function';
      if (!canReencode) { resolve(file); return; }
      let url = URL.createObjectURL(file);
      const video = document.createElement('video');
      video.muted = true;
      video.playsInline = true;
      video.preload = 'auto';
      video.src = url;
      video.onloadedmetadata = function () {
        try {
          const MAXW = 720;
          const w = Math.min(video.videoWidth, MAXW);
          const h = Math.round(video.videoHeight * (w / video.videoWidth));
          if (!w || !h) throw new Error('no dims');
          const canvas = document.createElement('canvas');
          canvas.width = w; canvas.height = h;
          const ctx = canvas.getContext('2d');
          const stream = canvas.captureStream(30);
          let combined = stream;
          if (video.captureStream) {
            try {
              const srcStream = video.captureStream();
              const audioTracks = srcStream.getAudioTracks();
              if (audioTracks.length) combined = new MediaStream(stream.getVideoTracks().concat(audioTracks));
            } catch (e2) {}
          }
          let mime = '';
          ['video/webm;codecs=vp9,opus','video/webm;codecs=vp8,opus','video/webm','video/mp4;codecs=h264,aac'].forEach(function (t) {
            if (!mime && typeof MediaRecorder.isTypeSupported === 'function' && MediaRecorder.isTypeSupported(t)) mime = t;
          });
          const rec = new MediaRecorder(combined, { mimeType: mime, videoBitsPerSecond: 600000, audioBitsPerSecond: 64000 });
          const chunks = [];
          rec.ondataavailable = function (e) { if (e.data && e.data.size) chunks.push(e.data); };
          let done = false;
          function finish() {
            if (done) return;
            done = true;
            try { video.pause(); } catch (e) {}
            URL.revokeObjectURL(url);
            try { rec.stop(); } catch (e) {}
            const blob = new Blob(chunks, { type: rec.mimeType || 'video/webm' });
            if (blob.size > 0 && blob.size < file.size) resolve(blob);
            else resolve(file);
          }
          rec.onstop = finish;
          video.onended = finish;
          setTimeout(function () { finish(); }, 60000);
          function draw() {
            if (!done && video.readyState >= 2) ctx.drawImage(video, 0, 0, w, h);
            requestAnimationFrame(draw);
          }
          draw();
          video.play().then(function () { rec.start(500); }).catch(function () { finish(); });
        } catch (err) {
          URL.revokeObjectURL(url);
          resolve(file);
        }
      };
      video.onerror = function () { URL.revokeObjectURL(url); resolve(file); };
    });
  }

  function blobToBase64(blob) {
    return new Promise(function (resolve, reject) {
      const fr = new FileReader();
      fr.onload = function () { resolve(fr.result); };
      fr.onerror = function () { reject(fr.error); };
      fr.readAsDataURL(blob);
    });
  }

  function showUploading(text) {
    uploadingText.textContent = text;
    show(uploading);
  }
  function hideUploading() { hide(uploading); }

  async function uploadFile(file) {
    try {
      showUploading('Memproses ' + file.name + '...');
      let blob = file;
      const isImg = file.type.indexOf('image/') === 0;
      const isVid = file.type.indexOf('video/') === 0;
      if (isImg) blob = await compressImageFile(file);
      else if (isVid) blob = await compressVideoFile(file);

      showUploading('Mengirim ' + (blob.name || file.name) + '...');
      const dataUrl = await blobToBase64(blob);
      const res = await fetch('/api/upload', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          roomId: roomId,
          senderName: senderName,
          mime: blob.type || file.type || 'application/octet-stream',
          name: file.name,
          size: blob.size,
          data: dataUrl
        })
      });
      const json = await res.json();
      if (!res.ok || !json.ok) throw new Error(json.error || 'Upload gagal');
    } catch (err) {
      alert('Gagal mengirim lampiran: ' + (err.message || 'Terjadi kesalahan'));
    } finally {
      hideUploading();
    }
  }

  // ---------- Render isi pesan ----------
  window.renderChatAttachmentBody = function (msg) {
    if (msg && msg.message_type === 'file') {
      const mime = String(msg.file_mime || '').toLowerCase();
      const name = esc(msg.file_name || 'Dokumen');
      const size = fmtBytes(msg.file_size);
      const url = '/api/file/' + esc(msg.id);
      if (mime.indexOf('image/') === 0) {
        return '<img class="chat-file-img" src="' + url + '" alt="' + name + '" onclick="window.open(\'' + url + '\',\'_blank\')" />';
      }
      if (mime.indexOf('video/') === 0) {
        return '<video class="chat-file-video" controls preload="metadata" src="' + url + '"></video>';
      }
      return '<a class="chat-file-doc" href="' + url + '" target="_blank"><span class="doc-icon">📄</span><span class="doc-meta"><span class="doc-name">' + name + '</span><span class="doc-size">' + size + '</span></span></a>';
    }
    return esc(msg.message);
  };
})();
