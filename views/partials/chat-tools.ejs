<% if (typeof senderName === 'undefined') senderName = ''; %>
<% if (typeof roomId === 'undefined') roomId = ''; %>

<!-- =============================================
     Fitur Emoji & Lampiran (dipakai di chat pasien & admin)
     ============================================= -->
<style>
  .ct-tools { display: flex; align-items: center; gap: 6px; flex: 0 0 auto; }
  .ct-tool { flex: 0 0 auto; background: var(--bg); border: 1px solid var(--border); border-radius: 8px; width: 40px; height: 42px; display: inline-flex; align-items: center; justify-content: center; font-size: 19px; cursor: pointer; color: var(--subtle); transition: all .15s ease-in-out; padding: 0; }
  .ct-tool:hover, .ct-tool.active { color: var(--primary); border-color: var(--primary); background: var(--primary-light); }
  .ct-panel { position: absolute; bottom: calc(100% + 8px); right: 0; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,.15); z-index: 50; }
  .ct-panel[hidden] { display: none; }
  .ct-attach-list { padding: 6px; display: flex; flex-direction: column; min-width: 185px; }
  .ct-attach-list button { display: flex; align-items: center; gap: 10px; background: none; border: none; padding: 10px 12px; border-radius: 8px; font-size: 14px; color: var(--text); cursor: pointer; text-align: left; width: 100%; }
  .ct-attach-list button:hover { background: var(--primary-light); color: var(--primary); }
  .ct-emoji-grid { display: grid; grid-template-columns: repeat(8, 1fr); gap: 4px; padding: 10px; max-width: 320px; max-height: 220px; overflow-y: auto; }
  .ct-emoji-grid button { background: none; border: none; font-size: 24px; padding: 4px; cursor: pointer; border-radius: 6px; line-height: 1; }
  .ct-emoji-grid button:hover { background: var(--primary-light); }
  .ct-emoji-input { position: fixed; left: -9999px; top: 0; width: 1px; height: 1px; opacity: 0; pointer-events: none; border: none; padding: 0; }
  .ct-uploading { position: absolute; bottom: calc(100% + 8px); left: 0; right: 0; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 10px 14px; font-size: 13px; color: var(--subtle); display: flex; align-items: center; gap: 10px; box-shadow: 0 10px 30px rgba(0,0,0,.15); z-index: 50; }
  .ct-uploading[hidden] { display: none; }
  .ct-uploading .ct-spinner { width: 16px; height: 16px; border: 2px solid var(--primary-light); border-top-color: var(--primary); border-radius: 50%; animation: ct-spin .8s linear infinite; flex: 0 0 auto; }
  .ct-uploading .ct-u-text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @keyframes ct-spin { to { transform: rotate(360deg); } }

  /* Tampilan lampiran di dalam gelembung pesan */
  .chat-file { display: block; }
  .chat-file-img { display: block; max-width: 100%; max-height: 260px; border-radius: 8px; cursor: pointer; margin: 2px 0; }
  .chat-file-video { display: block; max-width: 100%; max-height: 260px; border-radius: 8px; margin: 2px 0; }
  .chat-file-doc { display: flex; align-items: center; gap: 10px; padding: 8px 10px; background: rgba(0,0,0,.05); border-radius: 8px; text-decoration: none; color: var(--text); min-width: 180px; max-width: 260px; margin: 2px 0; }
  .msg-mine .chat-file-doc, .msg-admin .chat-file-doc { background: rgba(255,255,255,.2); color: #fff; }
  .chat-file-doc .doc-icon { font-size: 26px; flex: 0 0 auto; }
  .chat-file-doc .doc-meta { min-width: 0; display: flex; flex-direction: column; }
  .chat-file-doc .doc-name { font-size: 13px; font-weight: 600; word-break: break-word; }
  .chat-file-doc .doc-size { font-size: 11px; opacity: .7; }

  @media (max-width: 768px) {
    .ct-tool { width: 38px; height: 40px; }
  }
  @media (max-width: 576px) {
    .ct-tool { width: 36px; height: 38px; font-size: 17px; }
    .ct-emoji-grid { grid-template-columns: repeat(7, 1fr); max-width: 280px; max-height: 180px; }
  }
</style>

<div class="ct-tools" data-sender="<%= senderName %>" data-room="<%= roomId %>">
  <button type="button" class="ct-tool" id="ctEmojiBtn" title="Emoji">😊</button>
  <button type="button" class="ct-tool" id="ctAttachBtn" title="Lampirkan">📎</button>

  <!-- Input tersembunyi untuk membuka keyboard emoji bawaan HP -->
  <input type="text" class="ct-emoji-input" id="ctEmojiInput" inputmode="emoji" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" />

  <input type="file" id="ctFileCamera" accept="image/*,video/*" capture="environment" hidden />
  <input type="file" id="ctFileGallery" accept="image/*,video/*" hidden />
  <input type="file" id="ctFileDoc" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.zip,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" hidden />

  <div class="ct-panel" id="ctAttachPanel" hidden>
    <div class="ct-attach-list">
      <button type="button" data-target="ctFileCamera">📷 Kamera</button>
      <button type="button" data-target="ctFileGallery">🖼️ Galeri</button>
      <button type="button" data-target="ctFileDoc">📄 Dokumen</button>
    </div>
  </div>

  <div class="ct-panel" id="ctEmojiPanel" hidden>
    <div class="ct-emoji-grid" id="ctEmojiGrid"></div>
  </div>

  <div class="ct-uploading" id="ctUploading" hidden>
    <span class="ct-spinner"></span>
    <span class="ct-u-text" id="ctUploadingText">Mengirim lampiran...</span>
  </div>
</div>

<script>
(function () {
  const tools = document.querySelector('.ct-tools');
  if (!tools) return;
  const roomId = tools.getAttribute('data-room') || '';
  const senderName = tools.getAttribute('data-sender') || '';
  const msgInput = document.getElementById('msgInput');
  const emojiBtn = document.getElementById('ctEmojiBtn');
  const attachBtn = document.getElementById('ctAttachBtn');
  const emojiPanel = document.getElementById('ctEmojiPanel');
  const attachPanel = document.getElementById('ctAttachPanel');
  const emojiInput = document.getElementById('ctEmojiInput');
  const uploading = document.getElementById('ctUploading');
  const uploadingText = document.getElementById('ctUploadingText');
  const isMobile = /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent);

  function show(el) { el.hidden = false; }
  function hide(el) { el.hidden = true; }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function fmtBytes(b) {
    b = parseInt(b, 10) || 0;
    if (b >= 1048576) return (b / 1048576).toFixed(1) + ' MB';
    if (b >= 1024) return (b / 1024).toFixed(1) + ' KB';
    return b + ' B';
  }

  // ---------- Emoji picker (desktop) ----------
  const EMOJIS = ['😀','😁','😂','🤣','😊','😍','😘','😎','🤩','🥰','😇','🙂','😉','😌','😋','😜','🤪','🧐','🤓','😏','😒','🙄','😔','😢','😭','😤','😠','🤯','😳','🥺','😱','😷','🤒','🤕','🤢','🤮','🥵','🥶','😴','😪','🤗','🤔','👍','👎','👌','✌️','🤞','🤙','👏','🙌','🙏','🤝','💪','❤️','🧡','💛','💚','💙','💜','🖤','💖','💯','✨','🔥','🎉','🎂','⭐','🌈','☀️','🌙','⏰','📞','📱','💉','💊','🏥','🚑','🩺','✅','❌','⚠️','ℹ️','📎','📄','📷','🎥','🖼️'];
  const grid = document.getElementById('ctEmojiGrid');
  EMOJIS.forEach(function (e) {
    const b = document.createElement('button');
    b.type = 'button';
    b.textContent = e;
    b.onclick = function () {
      msgInput.value += e;
      hide(emojiPanel);
      msgInput.focus();
    };
    grid.appendChild(b);
  });

  // Tombol emoji: di HP membuka keyboard emoji bawaan, di desktop membuka panel
  emojiBtn.addEventListener('click', function () {
    hide(attachPanel);
    if (isMobile) {
      hide(emojiPanel);
      emojiInput.value = '';
      emojiInput.focus();
    } else {
      emojiPanel.hidden = !emojiPanel.hidden;
      if (!emojiPanel.hidden) msgInput.focus();
    }
  });

  // Emoji dari keyboard bawaan HP masuk ke kotak pesan
  emojiInput.addEventListener('input', function () {
    if (emojiInput.value) {
      msgInput.value += emojiInput.value;
      emojiInput.value = '';
      msgInput.focus();
    }
  });
  emojiInput.addEventListener('blur', function () { emojiInput.value = ''; });

  // ---------- Lampiran ----------
  attachBtn.addEventListener('click', function () {
    hide(emojiPanel);
    attachPanel.hidden = !attachPanel.hidden;
  });

  attachPanel.addEventListener('click', function (e) {
    const btn = e.target.closest('button[data-target]');
    if (!btn) return;
    hide(attachPanel);
    const input = document.getElementById(btn.getAttribute('data-target'));
    if (input) input.click();
  });

  ['ctFileCamera', 'ctFileGallery', 'ctFileDoc'].forEach(function (id) {
    const input = document.getElementById(id);
    if (!input) return;
    input.addEventListener('change', function () {
      const file = input.files && input.files[0];
      input.value = '';
      if (file) uploadFile(file);
    });
  });

  // ---------- Kompresi ----------
  function compressImageFile(file) {
    return new Promise(function (resolve) {
      const MAX = 1280;
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = function () {
        let w = img.naturalWidth, h = img.naturalHeight;
        if (!w || !h) { URL.revokeObjectURL(url); resolve(file); return; }
        const r = Math.min(1, MAX / Math.max(w, h));
        w = Math.max(1, Math.round(w * r));
        h = Math.max(1, Math.round(h * r));
        const canvas = document.createElement('canvas');
        canvas.width = w; canvas.height = h;
        canvas.getContext('2d').drawImage(img, 0, 0, w, h);
        URL.revokeObjectURL(url);
        canvas.toBlob(function (blob) {
          if (blob && blob.size < file.size) resolve(blob);
          else resolve(file);
        }, 'image/jpeg', 0.72);
      };
      img.onerror = function () { URL.revokeObjectURL(url); resolve(file); };
      img.src = url;
    });
  }

  function compressVideoFile(file) {
    return new Promise(function (resolve) {
      const canReencode = typeof MediaRecorder !== 'undefined' &&
        typeof HTMLCanvasElement !== 'undefined' &&
        typeof HTMLCanvasElement.prototype.captureStream === 'function';
      if (!canReencode) { resolve(file); return; }
      let url = URL.createObjectURL(file);
      const video = document.createElement('video');
      video.muted = true;
      video.playsInline = true;
      video.preload = 'auto';
      video.src = url;
      video.onloadedmetadata = function () {
        try {
          const MAXW = 720;
          const w = Math.min(video.videoWidth, MAXW);
          const h = Math.round(video.videoHeight * (w / video.videoWidth));
          if (!w || !h) throw new Error('no dims');
          const canvas = document.createElement('canvas');
          canvas.width = w; canvas.height = h;
          const ctx = canvas.getContext('2d');
          const stream = canvas.captureStream(30);
          let combined = stream;
          if (video.captureStream) {
            try {
              const srcStream = video.captureStream();
              const audioTracks = srcStream.getAudioTracks();
              if (audioTracks.length) combined = new MediaStream(stream.getVideoTracks().concat(audioTracks));
            } catch (e2) {}
          }
          let mime = '';
          ['video/webm;codecs=vp9,opus','video/webm;codecs=vp8,opus','video/webm','video/mp4;codecs=h264,aac'].forEach(function (t) {
            if (!mime && typeof MediaRecorder.isTypeSupported === 'function' && MediaRecorder.isTypeSupported(t)) mime = t;
          });
          const rec = new MediaRecorder(combined, { mimeType: mime, videoBitsPerSecond: 600000, audioBitsPerSecond: 64000 });
          const chunks = [];
          rec.ondataavailable = function (e) { if (e.data && e.data.size) chunks.push(e.data); };
          let done = false;
          function finish() {
            if (done) return;
            done = true;
            try { video.pause(); } catch (e) {}
            URL.revokeObjectURL(url);
            try { rec.stop(); } catch (e) {}
            const blob = new Blob(chunks, { type: rec.mimeType || 'video/webm' });
            if (blob.size > 0 && blob.size < file.size) resolve(blob);
            else resolve(file);
          }
          rec.onstop = finish;
          video.onended = finish;
          setTimeout(function () { finish(); }, 60000);
          function draw() {
            if (!done && video.readyState >= 2) ctx.drawImage(video, 0, 0, w, h);
            requestAnimationFrame(draw);
          }
          draw();
          video.play().then(function () { rec.start(500); }).catch(function () { finish(); });
        } catch (err) {
          URL.revokeObjectURL(url);
          resolve(file);
        }
      };
      video.onerror = function () { URL.revokeObjectURL(url); resolve(file); };
    });
  }

  function blobToBase64(blob) {
    return new Promise(function (resolve, reject) {
      const fr = new FileReader();
      fr.onload = function () { resolve(fr.result); };
      fr.onerror = function () { reject(fr.error); };
      fr.readAsDataURL(blob);
    });
  }

  function showUploading(text) {
    uploadingText.textContent = text;
    show(uploading);
  }
  function hideUploading() { hide(uploading); }

  async function uploadFile(file) {
    try {
      showUploading('Memproses ' + file.name + '...');
      let blob = file;
      const isImg = file.type.indexOf('image/') === 0;
      const isVid = file.type.indexOf('video/') === 0;
      if (isImg) blob = await compressImageFile(file);
      else if (isVid) blob = await compressVideoFile(file);
      // Dokumen tidak bisa dikompres di sisi browser, dikirim apa adanya (ukuran dibatasi di server)

      showUploading('Mengirim ' + (blob.name || file.name) + '...');
      const dataUrl = await blobToBase64(blob);
      const res = await fetch('/api/upload', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          roomId: roomId,
          senderName: senderName,
          mime: blob.type || file.type || 'application/octet-stream',
          name: file.name,
          size: blob.size,
          data: dataUrl
        })
      });
      const json = await res.json();
      if (!res.ok || !json.ok) throw new Error(json.error || 'Upload gagal');
    } catch (err) {
      alert('Gagal mengirim lampiran: ' + (err.message || 'Terjadi kesalahan'));
    } finally {
      hideUploading();
    }
  }

  // ---------- Render isi pesan (dipakai oleh appendMessage kedua tampilan) ----------
  window.renderChatAttachmentBody = function (msg) {
    if (msg && msg.message_type === 'file') {
      const mime = String(msg.file_mime || '').toLowerCase();
      const name = esc(msg.file_name || 'Dokumen');
      const size = fmtBytes(msg.file_size);
      const url = '/api/file/' + esc(msg.id);
      if (mime.indexOf('image/') === 0) {
        return '<img class="chat-file-img" src="' + url + '" alt="' + name + '" onclick="window.open(\'' + url + '\',\'_blank\')" />';
      }
      if (mime.indexOf('video/') === 0) {
        return '<video class="chat-file-video" controls preload="metadata" src="' + url + '"></video>';
      }
      return '<a class="chat-file-doc" href="' + url + '" target="_blank"><span class="doc-icon">📄</span><span class="doc-meta"><span class="doc-name">' + name + '</span><span class="doc-size">' + size + '</span></span></a>';
    }
    return esc(msg.message);
  };
})();
</script>
