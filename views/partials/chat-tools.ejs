<% if (typeof senderName === 'undefined') senderName = ''; %>
<% if (typeof roomId === 'undefined') roomId = ''; %>
<% if (typeof placeholder === 'undefined') placeholder = 'Ketik pesan...'; %>

<!-- =============================================
     Fitur Emoji & Lampiran (dipakai di chat pasien & admin)
     ============================================= -->
<style>
  /* Kotak ketik: input + ikon menyatu dalam satu box */
  .ct-composer { flex: 1; display: flex; align-items: center; gap: 2px; min-width: 0; background: var(--bg); border: 1px solid var(--border); border-radius: 22px; padding: 4px 6px 4px 14px; transition: border-color .15s ease-in-out, box-shadow .15s ease-in-out; }
  .ct-composer:focus-within { border-color: var(--primary); box-shadow: 0 0 0 0.15rem rgba(14,165,233,.18); }
  .ct-composer input { flex: 1; min-width: 0; background: transparent; border: none; padding: 9px 0; font-size: 14px; color: var(--text); }
  .ct-composer input:focus { outline: none; border: none; box-shadow: none; }

  /* Ikon garis minimalis tanpa background */
  button.ct-tool { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; background: transparent !important; border: none !important; padding: 0 !important; margin: 0; color: var(--subtle); cursor: pointer; border-radius: 50% !important; box-shadow: none !important; -webkit-tap-highlight-color: transparent; transition: color .15s ease-in-out, background .15s ease-in-out; }
  button.ct-tool:hover, button.ct-tool.active { color: var(--primary); background: transparent !important; }
  button.ct-tool:focus, button.ct-tool:focus-visible { outline: none !important; box-shadow: none !important; background: transparent !important; }
  button.ct-tool svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }

  .ct-panel { position: absolute; bottom: calc(100% + 8px); right: 0; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,.15); z-index: 50; }
  .ct-panel[hidden] { display: none; }
  .ct-attach-list { padding: 6px; display: flex; flex-direction: column; min-width: 185px; }
  .ct-attach-list button { display: flex; align-items: center; gap: 10px; background: none; border: none; padding: 10px 12px; border-radius: 8px; font-size: 14px; color: var(--text); cursor: pointer; text-align: left; width: 100%; }
  .ct-attach-list button:hover { background: var(--primary-light); color: var(--primary); }
  .ct-attach-list button svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; flex: 0 0 auto; }
  .ct-emoji-grid { display: grid; grid-template-columns: repeat(8, 1fr); gap: 4px; padding: 10px; max-width: 320px; max-height: 220px; overflow-y: auto; }
  .ct-emoji-grid button { background: none; border: none; font-size: 24px; padding: 4px; cursor: pointer; border-radius: 6px; line-height: 1; }
  .ct-emoji-grid button:hover { background: var(--primary-light); }
  .ct-emoji-input { position: fixed; left: -9999px; top: 0; width: 1px; height: 1px; opacity: 0; pointer-events: none; border: none; padding: 0; }
  .ct-uploading { position: absolute; bottom: calc(100% + 8px); left: 0; right: 0; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 10px 14px; font-size: 13px; color: var(--subtle); display: flex; align-items: center; gap: 10px; box-shadow: 0 10px 30px rgba(0,0,0,.15); z-index: 50; }
  .ct-uploading[hidden] { display: none; }
  .ct-uploading .ct-spinner { width: 16px; height: 16px; border: 2px solid var(--primary-light); border-top-color: var(--primary); border-radius: 50%; animation: ct-spin .8s linear infinite; flex: 0 0 auto; }
  .ct-uploading .ct-u-text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @keyframes ct-spin { to { transform: rotate(360deg); } }

  /* Modal kamera (akses kamera langsung dari device) */
  .ct-camera-modal { position: fixed; inset: 0; background: rgba(15,23,42,.9); z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 20px; }
  .ct-camera-modal[hidden] { display: none; }
  .ct-camera-box { background: #000; border-radius: 16px; overflow: hidden; max-width: 520px; width: 100%; position: relative; }
  .ct-camera-box video { width: 100%; display: block; max-height: 70vh; object-fit: contain; background: #000; }
  .ct-camera-controls { display: flex; justify-content: center; align-items: center; gap: 28px; padding: 14px; }
  .ct-cam-btn { width: 54px; height: 54px; border-radius: 50%; border: 2px solid rgba(255,255,255,.9); background: rgba(255,255,255,.12); color: #fff; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: background .15s; }
  .ct-cam-btn:hover { background: rgba(255,255,255,.28); }
  .ct-cam-btn svg { width: 24px; height: 24px; fill: none; stroke: #fff; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .ct-cam-btn-sm { width: 46px; height: 46px; }
  .ct-camera-error { padding: 30px; color: #fff; text-align: center; font-size: 14px; }

  /* Tampilan lampiran di dalam gelembung pesan */
  .chat-file { display: block; }
  .chat-file-img { display: block; max-width: 100%; max-height: 260px; border-radius: 8px; cursor: pointer; margin: 2px 0; }
  .chat-file-video { display: block; max-width: 100%; max-height: 260px; border-radius: 8px; margin: 2px 0; }
  .chat-file-doc { display: flex; align-items: center; gap: 10px; padding: 8px 10px; background: rgba(0,0,0,.05); border-radius: 8px; text-decoration: none; color: var(--text); min-width: 180px; max-width: 260px; margin: 2px 0; }
  .msg-mine .chat-file-doc, .msg-admin .chat-file-doc { background: rgba(255,255,255,.2); color: #fff; }
  .chat-file-doc .doc-icon { font-size: 26px; flex: 0 0 auto; }
  .chat-file-doc .doc-meta { min-width: 0; display: flex; flex-direction: column; }
  .chat-file-doc .doc-name { font-size: 13px; font-weight: 600; word-break: break-word; }
  .chat-file-doc .doc-size { font-size: 11px; opacity: .7; }

  @media (max-width: 768px) {
    .ct-composer { border-radius: 20px; }
  }
  @media (max-width: 576px) {
    .ct-composer { padding: 3px 4px 3px 10px; }
    .ct-composer input { font-size: 16px; padding: 8px 0; }
    button.ct-tool { width: 30px; height: 30px; }
    button.ct-tool svg { width: 22px; height: 22px; }
    .ct-emoji-grid { grid-template-columns: repeat(7, 1fr); max-width: 280px; max-height: 180px; }
  }
</style>

<div class="ct-composer ct-tools" data-sender="<%= senderName %>" data-room="<%= roomId %>">
  <input type="text" id="msgInput" placeholder="<%= placeholder %>" autocomplete="off" />

  <!-- Tombol emoji: di HP membuka keyboard emoji bawaan, di desktop membuka panel -->
  <button type="button" class="ct-tool" id="ctEmojiBtn" title="Emoji" aria-label="Emoji">
    <svg viewBox="0 0 24 24"><path d="M15 10V9"></path><path d="M16.472 15a6 6 0 0 1-8.943 0"></path><path d="M9 10V9"></path><circle cx="12" cy="12" r="10"></circle></svg>
  </button>

  <!-- Tombol lampiran -->
  <button type="button" class="ct-tool" id="ctAttachBtn" title="Lampirkan" aria-label="Lampirkan">
    <svg viewBox="0 0 24 24"><path d="m16 6-8.414 8.586a2 2 0 0 0 2.829 2.829l8.414-8.586a4 4 0 1 0-5.657-5.657l-8.379 8.551a6 6 0 1 0 8.485 8.485l8.379-8.551"></path></svg>
  </button>

  <!-- Input tersembunyi untuk membuka keyboard emoji bawaan HP -->
  <input type="text" class="ct-emoji-input" id="ctEmojiInput" inputmode="emoji" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" />

  <!-- Input file fallback (jika kamera browser tidak tersedia / ditolak) -->
  <input type="file" id="ctFileCamera" accept="image/*" capture="environment" hidden />
  <input type="file" id="ctFileGallery" accept="image/*,video/*" hidden />
  <input type="file" id="ctFileDoc" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.zip,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" hidden />

  <div class="ct-panel" id="ctAttachPanel" hidden>
    <div class="ct-attach-list">
      <button type="button" data-action="camera">
        <svg viewBox="0 0 24 24"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
        Kamera
      </button>
      <button type="button" data-action="gallery">
        <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg>
        Galeri
      </button>
      <button type="button" data-action="doc">
        <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path><path d="M16 13H8"></path><path d="M16 17H8"></path></svg>
        Dokumen
      </button>
    </div>
  </div>

  <div class="ct-panel" id="ctEmojiPanel" hidden>
    <div class="ct-emoji-grid" id="ctEmojiGrid"></div>
  </div>

  <div class="ct-uploading" id="ctUploading" hidden>
    <span class="ct-spinner"></span>
    <span class="ct-u-text" id="ctUploadingText">Mengirim lampiran...</span>
  </div>
</div>

<!-- Modal kamera -->
<div class="ct-camera-modal" id="ctCameraModal" hidden>
  <div class="ct-camera-box">
    <video id="ctCameraVideo" autoplay playsinline muted></video>
    <div class="ct-camera-controls">
      <button type="button" class="ct-cam-btn ct-cam-btn-sm" id="ctCameraSwitch" title="Ganti kamera" aria-label="Ganti kamera">
        <svg viewBox="0 0 24 24"><path d="M1 4v6h6"></path><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path></svg>
      </button>
      <button type="button" class="ct-cam-btn" id="ctCameraCapture" title="Ambil foto" aria-label="Ambil foto">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"></circle><circle cx="12" cy="12" r="3"></circle></svg>
      </button>
      <button type="button" class="ct-cam-btn ct-cam-btn-sm" id="ctCameraClose" title="Tutup" aria-label="Tutup">
        <svg viewBox="0 0 24 24"><path d="M18 6 6 18"></path><path d="M6 6l12 12"></path></svg>
      </button>
    </div>
  </div>
</div>

<script>
(function () {
  const composer = document.querySelector('.ct-tools');
  if (!composer) return;
  const roomId = composer.getAttribute('data-room') || '';
  const senderName = composer.getAttribute('data-sender') || '';
  const msgInput = document.getElementById('msgInput');
  const emojiBtn = document.getElementById('ctEmojiBtn');
  const attachBtn = document.getElementById('ctAttachBtn');
  const emojiPanel = document.getElementById('ctEmojiPanel');
  const attachPanel = document.getElementById('ctAttachPanel');
  const emojiInput = document.getElementById('ctEmojiInput');
  const uploading = document.getElementById('ctUploading');
  const uploadingText = document.getElementById('ctUploadingText');
  const cameraModal = document.getElementById('ctCameraModal');
  const cameraVideo = document.getElementById('ctCameraVideo');
  const isMobile = /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent);

  function show(el) { el.hidden = false; }
  function hide(el) { el.hidden = true; }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function fmtBytes(b) {
    b = parseInt(b, 10) || 0;
    if (b >= 1048576) return (b / 1048576).toFixed(1) + ' MB';
    if (b >= 1024) return (b / 1024).toFixed(1) + ' KB';
    return b + ' B';
  }

  // ---------- Emoji picker (desktop) ----------
  const EMOJIS = ['😀','😁','😂','🤣','😊','😍','😘','😎','🤩','🥰','😇','🙂','😉','😌','😋','😜','🤪','🧐','🤓','😏','😒','🙄','😔','😢','😭','😤','😠','🤯','😳','🥺','😱','😷','🤒','🤕','🤢','🤮','🥵','🥶','😴','😪','🤗','🤔','👍','👎','👌','✌️','🤞','🤙','👏','🙌','🙏','🤝','💪','❤️','🧡','💛','💚','💙','💜','🖤','💖','💯','✨','🔥','🎉','🎂','⭐','🌈','☀️','🌙','⏰','📞','📱','💉','💊','🏥','🚑','🩺','✅','❌','⚠️','ℹ️','📎','📄','📷','🎥','🖼️'];
  const grid = document.getElementById('ctEmojiGrid');
  EMOJIS.forEach(function (e) {
    const b = document.createElement('button');
    b.type = 'button';
    b.textContent = e;
    b.onclick = function () {
      msgInput.value += e;
      hide(emojiPanel);
      msgInput.focus();
    };
    grid.appendChild(b);
  });

  emojiBtn.addEventListener('click', function () {
    hide(attachPanel);
    if (isMobile) {
      hide(emojiPanel);
      emojiInput.value = '';
      emojiInput.focus();
    } else {
      emojiPanel.hidden = !emojiPanel.hidden;
      if (!emojiPanel.hidden) msgInput.focus();
    }
  });

  emojiInput.addEventListener('input', function () {
    if (emojiInput.value) {
      msgInput.value += emojiInput.value;
      emojiInput.value = '';
      msgInput.focus();
    }
  });
  emojiInput.addEventListener('blur', function () { emojiInput.value = ''; });

  // ---------- Panel lampiran ----------
  attachBtn.addEventListener('click', function () {
    hide(emojiPanel);
    attachPanel.hidden = !attachPanel.hidden;
  });

  attachPanel.addEventListener('click', function (e) {
    const btn = e.target.closest('button[data-action]');
    if (!btn) return;
    hide(attachPanel);
    const action = btn.getAttribute('data-action');
    if (action === 'camera') openCamera();
    else if (action === 'gallery') {
      const input = document.getElementById('ctFileGallery');
      if (input) input.click();
    } else if (action === 'doc') {
      const input = document.getElementById('ctFileDoc');
      if (input) input.click();
    }
  });

  ['ctFileCamera', 'ctFileGallery', 'ctFileDoc'].forEach(function (id) {
    const input = document.getElementById(id);
    if (!input) return;
    input.addEventListener('change', function () {
      const file = input.files && input.files[0];
      input.value = '';
      if (file) uploadFile(file);
    });
  });

  // ---------- Kamera (akses kamera langsung dari device) ----------
  let cameraStream = null;
  let cameraFacing = 'environment';

  function stopCamera() {
    if (cameraStream) {
      cameraStream.getTracks().forEach(function (t) { t.stop(); });
      cameraStream = null;
    }
    if (cameraVideo) cameraVideo.srcObject = null;
  }

  function startCamera() {
    stopCamera();
    return navigator.mediaDevices.getUserMedia({
      video: { facingMode: cameraFacing, width: { ideal: 1920 }, height: { ideal: 1920 } },
      audio: false
    }).then(function (stream) {
      cameraStream = stream;
      cameraVideo.srcObject = stream;
      show(cameraModal);
      cameraVideo.play().catch(function () {});
    });
  }

  function openCamera() {
    hide(attachPanel);
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      fallbackCamera();
      return;
    }
    startCamera().catch(function () { fallbackCamera(); });
  }

  function fallbackCamera() {
    const input = document.getElementById('ctFileCamera');
    if (input) input.click();
  }

  document.getElementById('ctCameraCapture').addEventListener('click', function () {
    if (!cameraVideo || !cameraVideo.videoWidth) return;
    const canvas = document.createElement('canvas');
    canvas.width = cameraVideo.videoWidth;
    canvas.height = cameraVideo.videoHeight;
    canvas.getContext('2d').drawImage(cameraVideo, 0, 0);
    stopCamera();
    hide(cameraModal);
    canvas.toBlob(function (blob) {
      if (blob) {
        const file = new File([blob], 'kamera_' + Date.now() + '.jpg', { type: 'image/jpeg' });
        uploadFile(file);
      }
    }, 'image/jpeg', 0.92);
  });

  document.getElementById('ctCameraSwitch').addEventListener('click', function () {
    cameraFacing = cameraFacing === 'environment' ? 'user' : 'environment';
    startCamera().catch(function () { fallbackCamera(); });
  });

  document.getElementById('ctCameraClose').addEventListener('click', function () {
    stopCamera();
    hide(cameraModal);
  });

  // ---------- Kompresi ----------
  function compressImageFile(file) {
    return new Promise(function (resolve) {
      const MAX = 1280;
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = function () {
        let w = img.naturalWidth, h = img.naturalHeight;
        if (!w || !h) { URL.revokeObjectURL(url); resolve(file); return; }
        const r = Math.min(1, MAX / Math.max(w, h));
        w = Math.max(1, Math.round(w * r));
        h = Math.max(1, Math.round(h * r));
        const canvas = document.createElement('canvas');
        canvas.width = w; canvas.height = h;
        canvas.getContext('2d').drawImage(img, 0, 0, w, h);
        URL.revokeObjectURL(url);
        canvas.toBlob(function (blob) {
          if (blob && blob.size < file.size) resolve(blob);
          else resolve(file);
        }, 'image/jpeg', 0.72);
      };
      img.onerror = function () { URL.revokeObjectURL(url); resolve(file); };
      img.src = url;
    });
  }

  function compressVideoFile(file) {
    return new Promise(function (resolve) {
      const canReencode = typeof MediaRecorder !== 'undefined' &&
        typeof HTMLCanvasElement !== 'undefined' &&
        typeof HTMLCanvasElement.prototype.captureStream === 'function';
      if (!canReencode) { resolve(file); return; }
      let url = URL.createObjectURL(file);
      const video = document.createElement('video');
      video.muted = true;
      video.playsInline = true;
      video.preload = 'auto';
      video.src = url;
      video.onloadedmetadata = function () {
        try {
          const MAXW = 720;
          const w = Math.min(video.videoWidth, MAXW);
          const h = Math.round(video.videoHeight * (w / video.videoWidth));
          if (!w || !h) throw new Error('no dims');
          const canvas = document.createElement('canvas');
          canvas.width = w; canvas.height = h;
          const ctx = canvas.getContext('2d');
          const stream = canvas.captureStream(30);
          let combined = stream;
          if (video.captureStream) {
            try {
              const srcStream = video.captureStream();
              const audioTracks = srcStream.getAudioTracks();
              if (audioTracks.length) combined = new MediaStream(stream.getVideoTracks().concat(audioTracks));
            } catch (e2) {}
          }
          let mime = '';
          ['video/webm;codecs=vp9,opus','video/webm;codecs=vp8,opus','video/webm','video/mp4;codecs=h264,aac'].forEach(function (t) {
            if (!mime && typeof MediaRecorder.isTypeSupported === 'function' && MediaRecorder.isTypeSupported(t)) mime = t;
          });
          const rec = new MediaRecorder(combined, { mimeType: mime, videoBitsPerSecond: 600000, audioBitsPerSecond: 64000 });
          const chunks = [];
          rec.ondataavailable = function (e) { if (e.data && e.data.size) chunks.push(e.data); };
          let done = false;
          function finish() {
            if (done) return;
            done = true;
            try { video.pause(); } catch (e) {}
            URL.revokeObjectURL(url);
            try { rec.stop(); } catch (e) {}
            const blob = new Blob(chunks, { type: rec.mimeType || 'video/webm' });
            if (blob.size > 0 && blob.size < file.size) resolve(blob);
            else resolve(file);
          }
          rec.onstop = finish;
          video.onended = finish;
          setTimeout(function () { finish(); }, 60000);
          function draw() {
            if (!done && video.readyState >= 2) ctx.drawImage(video, 0, 0, w, h);
            requestAnimationFrame(draw);
          }
          draw();
          video.play().then(function () { rec.start(500); }).catch(function () { finish(); });
        } catch (err) {
          URL.revokeObjectURL(url);
          resolve(file);
        }
      };
      video.onerror = function () { URL.revokeObjectURL(url); resolve(file); };
    });
  }

  function blobToBase64(blob) {
    return new Promise(function (resolve, reject) {
      const fr = new FileReader();
      fr.onload = function () { resolve(fr.result); };
      fr.onerror = function () { reject(fr.error); };
      fr.readAsDataURL(blob);
    });
  }

  function showUploading(text) {
    uploadingText.textContent = text;
    show(uploading);
  }
  function hideUploading() { hide(uploading); }

  async function uploadFile(file) {
    try {
      showUploading('Memproses ' + file.name + '...');
      let blob = file;
      const isImg = file.type.indexOf('image/') === 0;
      const isVid = file.type.indexOf('video/') === 0;
      if (isImg) blob = await compressImageFile(file);
      else if (isVid) blob = await compressVideoFile(file);
      // Dokumen tidak bisa dikompres di sisi browser, dikirim apa adanya (ukuran dibatasi di server)

      showUploading('Mengirim ' + (blob.name || file.name) + '...');
      const dataUrl = await blobToBase64(blob);
      const res = await fetch('/api/upload', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          roomId: roomId,
          senderName: senderName,
          mime: blob.type || file.type || 'application/octet-stream',
          name: file.name,
          size: blob.size,
          data: dataUrl
        })
      });
      const json = await res.json();
      if (!res.ok || !json.ok) throw new Error(json.error || 'Upload gagal');
    } catch (err) {
      alert('Gagal mengirim lampiran: ' + (err.message || 'Terjadi kesalahan'));
    } finally {
      hideUploading();
    }
  }

  // ---------- Render isi pesan (dipakai oleh appendMessage kedua tampilan) ----------
  window.renderChatAttachmentBody = function (msg) {
    if (msg && msg.message_type === 'file') {
      const mime = String(msg.file_mime || '').toLowerCase();
      const name = esc(msg.file_name || 'Dokumen');
      const size = fmtBytes(msg.file_size);
      const url = '/api/file/' + esc(msg.id);
      if (mime.indexOf('image/') === 0) {
        return '<img class="chat-file-img" src="' + url + '" alt="' + name + '" onclick="window.open(\'' + url + '\',\'_blank\')" />';
      }
      if (mime.indexOf('video/') === 0) {
        return '<video class="chat-file-video" controls preload="metadata" src="' + url + '"></video>';
      }
      return '<a class="chat-file-doc" href="' + url + '" target="_blank"><span class="doc-icon">📄</span><span class="doc-meta"><span class="doc-name">' + name + '</span><span class="doc-size">' + size + '</span></span></a>';
    }
    return esc(msg.message);
  };
})();
</script>
