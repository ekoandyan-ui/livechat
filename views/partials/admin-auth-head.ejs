<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' && title ? title : 'Admin' %> - Live Chat</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    :root {
      --primary: #0ea5e9;
      --primary-dark: #0284c7;
      --primary-light: #e0f2fe;
      --bg: #f8fafc;
      --surface: #ffffff;
      --text: #0f172a;
      --subtle: #64748b;
      --border: rgba(0, 0, 0, 0.1);
    }
    body { background: var(--bg); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 16px; }
    .login-card { background: var(--surface); border-radius: 12px; padding: 32px; width: 100%; max-width: 360px; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1); border: 1px solid var(--border); }
    .login-card h2 { color: var(--primary); text-align: center; margin-bottom: 5px; font-weight: 700; font-size: 22px; }
    .login-card .subtitle { color: var(--subtle); text-align: center; font-size: 13px; margin-bottom: 25px; }
    .form-control { background: var(--surface); border: 1px solid var(--border); color: var(--text); padding: 12px; }
    .form-control:focus { background: var(--surface); color: var(--text); border-color: var(--primary); box-shadow: none; }
    .password-wrap { position: relative; }
    .password-wrap .form-control { padding-right: 44px; }
    .pw-toggle { position: absolute; right: 4px; top: 50%; transform: translateY(-50%); width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; border: none; background: transparent; color: var(--subtle); cursor: pointer; border-radius: 8px; }
    .pw-toggle:hover { color: var(--primary); }
    .pw-toggle svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .form-label { color: var(--text); font-size: 14px; }
    .btn-login { background: var(--primary); border: none; padding: 12px; font-weight: 600; width: 100%; margin-top: 10px; color: #fff; }
    .btn-login:hover { background: var(--primary-dark); color: #fff; }
    .alert { font-size: 14px; }
    .hint { color: var(--subtle); font-size: 12px; margin-top: 6px; }
    .back-link { display: block; text-align: center; margin-top: 16px; font-size: 13px; }
  </style>
</head>
<body>
  <div class="login-card">
