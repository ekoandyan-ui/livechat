<div class="mb-3">
  <label class="form-label"><%= label %></label>
  <div class="password-wrap">
    <input type="password" name="<%= name %>" id="<%= id %>" class="form-control" placeholder="<%= typeof placeholder !== 'undefined' && placeholder ? placeholder : 'Masukkan password' %>" autocomplete="<%= autocomplete %>" required />
    <button type="button" class="pw-toggle" aria-label="Lihat password" tabindex="-1">
      <svg class="eye-on" viewBox="0 0 24 24"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg>
      <svg class="eye-off" viewBox="0 0 24 24" hidden><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"></path><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"></path><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"></path><path d="m2 2 20 20"></path></svg>
    </button>
  </div>
  <% if (typeof hint !== 'undefined' && hint) { %><div class="hint"><%= hint %></div><% } %>
</div>
