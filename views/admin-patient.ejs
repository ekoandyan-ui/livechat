<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Data Pasien - Admin</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    :root {
      --primary: #0ea5e9;
      --primary-dark: #0284c7;
      --primary-light: #e0f2fe;
      --bg: #f8fafc;
      --surface: #ffffff;
      --text: #0f172a;
      --subtle: #64748b;
      --border: rgba(0, 0, 0, 0.1);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: var(--bg); color: var(--text); min-height: 100vh; font-family: 'Segoe UI', sans-serif; }
    .page-header { background: var(--surface); padding: 15px 25px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 15px; }
    .page-header .back-btn { color: var(--primary); text-decoration: none; font-weight: 600; margin-right: 15px; }
    .page-header .back-btn:hover { color: var(--primary-dark); }
    .page-header h4 { margin: 0; font-size: 18px; }
    .page-header .rs-badge { background: var(--primary-light); color: var(--primary); font-size: 11px; padding: 4px 10px; border-radius: 8px; font-weight: 600; margin-left: auto; }
    .container-card { max-width: 600px; margin: 25px auto; padding: 0 15px; }
    .data-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05); }
    .data-row { display: flex; padding: 15px 20px; border-bottom: 1px solid var(--border); gap: 15px; flex-wrap: wrap; }
    .data-row:last-child { border-bottom: none; }
    .data-label { width: 130px; flex-shrink: 0; color: var(--subtle); font-size: 13px; font-weight: 600; }
    .data-value { flex: 1; font-size: 14px; word-break: break-word; color: var(--text); }
    .data-value a { color: var(--primary); text-decoration: none; }
    .data-value a:hover { text-decoration: underline; }
    .action-bar { margin-top: 20px; display: flex; gap: 10px; flex-wrap: wrap; }
    .btn-chat { background: var(--primary); border: none; color: #fff; padding: 11px 20px; border-radius: 8px; font-weight: 600; text-decoration: none; font-size: 14px; cursor: pointer; }
    .btn-chat:hover { background: var(--primary-dark); color: #fff; }
    .btn-danger { background: #e74c3c; border: none; color: #fff; padding: 11px 20px; border-radius: 8px; font-weight: 600; font-size: 14px; cursor: pointer; }
    .btn-danger:hover { background: #c0392b; }

    @media (max-width: 576px) {
      .page-header { padding: 10px 12px; gap: 8px; }
      .page-header .back-btn { font-size: 14px; margin-right: 8px; }
      .page-header h4 { font-size: 16px; }
      .container-card { margin: 15px auto; }
      .data-row { padding: 13px 15px; gap: 10px; }
      .data-label { width: 110px; font-size: 12px; }
      .data-value { font-size: 13px; }
      .btn-chat, .btn-danger { padding: 11px 15px; font-size: 13px; }
    }
  </style>
</head>
<body>
  <div class="page-header">
    <a href="/admin/room/<%= user.id %>" class="back-btn">&larr; Kembali</a>
    <h4>DATA PASIEN</h4>
    <span class="rs-badge"><%= adminRumahSakit %></span>
  </div>

  <div class="container-card">
    <div class="data-card">
      <div class="data-row">
        <div class="data-label">ID Pasien</div>
        <div class="data-value"><%= user.id %></div>
      </div>
      <div class="data-row">
        <div class="data-label">Nama Lengkap</div>
        <div class="data-value"><%= user.nama %></div>
      </div>
      <div class="data-row">
        <div class="data-label">Alamat</div>
        <div class="data-value"><%= user.alamat %></div>
      </div>
      <div class="data-row">
        <div class="data-label">Nomor WhatsApp</div>
        <div class="data-value"><a href="tel:<%= user.nomor_wa %>"><%= user.nomor_wa %></a></div>
      </div>
      <div class="data-row">
        <div class="data-label">Rumah Sakit</div>
        <div class="data-value"><%= user.rumah_sakit %></div>
      </div>
      <div class="data-row">
        <div class="data-label">Tanggal Daftar</div>
        <div class="data-value"><%= user.created_at ? new Date(user.created_at).toLocaleString('id-ID', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' }) : '-' %></div>
      </div>
    </div>

    <div class="action-bar">
      <a href="/admin/room/<%= user.id %>" class="btn-chat">Buka Chat</a>
      <form method="POST" action="/admin/patient/delete" style="margin:0;" onsubmit="return confirm('Hapus total chat pasien ini? Semua pesan akan dihapus dan pasien akan kembali ke form pendaftaran awal.')">
        <input type="hidden" name="patientId" value="<%= user.id %>" />
        <button type="submit" class="btn-danger">Hapus Total Chat</button>
      </form>
    </div>
  </div>
</body>
</html>
