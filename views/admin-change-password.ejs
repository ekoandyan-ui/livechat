<%- include('partials/admin-auth-head', { title: 'Keamanan Akun' }) %>
    <h2>KEAMANAN AKUN</h2>
    <p class="subtitle">Perbarui password dan kelola verifikasi dua langkah (MFA)</p>
    <% if (done) { %>
      <div class="alert alert-success">Password berhasil diubah. Sesi lain telah dicabut.</div>
    <% } else { %>
      <% if (error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>
      <form method="POST" action="/admin/change-password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <%- include('partials/password-field', { name: 'current', id: 'pw0', label: 'Password Saat Ini', autocomplete: 'current-password', placeholder: 'Password saat ini' }) %>
        <%- include('partials/password-field', { name: 'password', id: 'pw1', label: 'Password Baru', autocomplete: 'new-password', placeholder: 'Minimal 12 karakter', hint: 'Minimal 12 karakter. Hindari password umum atau sama dengan email.' }) %>
        <%- include('partials/password-field', { name: 'password2', id: 'pw2', label: 'Ulangi Password Baru', autocomplete: 'new-password', placeholder: 'Ulangi password baru' }) %>
        <button type="submit" class="btn btn-login">SIMPAN PASSWORD</button>
      </form>
    <% } %>

    <hr style="margin:22px 0;border-color:var(--border)" />
    <h2 style="font-size:17px">VERIFIKASI DUA LANGKAH (MFA)</h2>
    <% if (mfaEnabled) { %>
      <div class="alert alert-success" style="font-size:13px">MFA <strong>AKTIF</strong> pada akun ini.</div>
      <% if (isSuper) { %>
        <div class="alert alert-warning" style="font-size:13px">
          MFA wajib untuk Super Admin dan tidak dapat dimatikan.
        </div>
      <% } else { %>
        <details style="font-size:13px">
          <summary>Matikan MFA</summary>
          <form method="POST" action="/admin/mfa/disable" style="margin-top:10px">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <%- include('partials/password-field', { name: 'password', id: 'pwD', label: 'Password', autocomplete: 'current-password', placeholder: 'Password akun' }) %>
            <label class="form-label" for="codeD">Kode MFA 6 digit</label>
            <input class="form-control" id="codeD" name="code" inputmode="numeric" maxlength="6" placeholder="000000" />
            <button type="submit" class="btn btn-login" style="margin-top:10px">MATIKAN MFA</button>
          </form>
        </details>
      <% } %>
      <details style="font-size:13px;margin-top:10px">
        <summary>Buat ulang kode pemulihan</summary>
        <form method="POST" action="/admin/mfa/recovery/regenerate" style="margin-top:10px">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <%- include('partials/password-field', { name: 'password', id: 'pwR', label: 'Password', autocomplete: 'current-password', placeholder: 'Password akun' }) %>
          <label class="form-label" for="codeR">Kode MFA 6 digit</label>
          <input class="form-control" id="codeR" name="code" inputmode="numeric" maxlength="6" placeholder="000000" />
          <button type="submit" class="btn btn-login" style="margin-top:10px">BUAT ULANG KODE</button>
        </form>
      </details>
    <% } else { %>
      <div class="alert alert-warning" style="font-size:13px">
        MFA belum aktif. Aktifkan untuk menambah lapisan keamanan.
      </div>
      <a class="btn btn-login" href="/admin/mfa/setup" style="display:block;text-align:center;text-decoration:none">AKTIFKAN MFA</a>
    <% } %>
    <a class="back-link" href="/admin">Kembali ke Dashboard</a>
<%- include('partials/admin-auth-foot') %>
