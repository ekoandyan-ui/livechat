<%- include('partials/admin-auth-head', { title: 'Lupa Password' }) %>
    <h2>LUPA PASSWORD</h2>
    <p class="subtitle">Password baru akan dikirim ke email terdaftar</p>
    <% if (info) { %>
      <div class="alert alert-info"><%= info %></div>
    <% } %>
    <form method="POST" action="/admin/forgot-password">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" name="email" class="form-control" placeholder="Masukkan email admin" autocomplete="email" required autofocus />
      </div>
      <button type="submit" class="btn btn-login">KIRIM PASSWORD BARU</button>
    </form>
    <a class="back-link" href="/admin/login">Kembali ke Login</a>
<%- include('partials/admin-auth-foot') %>
