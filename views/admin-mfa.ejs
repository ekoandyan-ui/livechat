<%- include('partials/admin-auth-head', { title: 'Verifikasi Dua Langkah' }) %>
    <h2>VERIFIKASI MFA</h2>
    <p class="subtitle">
      <%= mode === 'stepup' ? 'Konfirmasi ulang untuk tindakan sensitif' : 'Masukkan kode dari aplikasi autentikator' %>
    </p>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <form method="POST" action="/admin/mfa">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <% if (mode === 'stepup' && next) { %><input type="hidden" name="next" value="<%= next %>" /><% } %>
      <div class="mb-3">
        <label class="form-label" for="code">Kode 6 digit</label>
        <input class="form-control" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="000000" autofocus />
      </div>
      <button type="submit" class="btn btn-login">VERIFIKASI</button>
    </form>
    <details style="margin-top:16px;font-size:13px">
      <summary>Gunakan kode pemulihan</summary>
      <form method="POST" action="/admin/mfa" style="margin-top:10px">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <% if (mode === 'stepup' && next) { %><input type="hidden" name="next" value="<%= next %>" /><% } %>
        <input class="form-control" name="recovery" placeholder="XXXXX-XXXXX" autocomplete="off" />
        <button type="submit" class="btn btn-login" style="margin-top:10px">PAKAI KODE PEMULIHAN</button>
      </form>
    </details>
    <a class="back-link" href="/admin/logout">Keluar</a>
<%- include('partials/admin-auth-foot') %>
