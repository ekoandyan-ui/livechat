<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    :root {
      --primary: #0ea5e9;
      --primary-dark: #0284c7;
      --primary-light: #e0f2fe;
      --bg: #f8fafc;
      --surface: #ffffff;
      --text: #0f172a;
      --subtle: #64748b;
      --border: rgba(0, 0, 0, 0.1);
    }
    body { background: var(--bg); color: var(--text); min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; padding: 20px; position: relative; }
    .main-card { background: var(--surface); border-radius: 16px; padding: 35px 30px; width: 100%; max-width: 480px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1); border: 1px solid var(--border); }
    .main-card h3 { color: var(--primary); font-weight: 700; text-align: center; margin-bottom: 8px; font-size: 24px; }
    .main-card p.subtitle { color: var(--subtle); text-align: center; font-size: 14px; margin-bottom: 30px; }
    .form-control, .form-select { background: var(--surface); border: 1px solid var(--border); color: var(--text); padding: 12px 15px; border-radius: 10px; }
    .form-control:focus, .form-select:focus { background: var(--surface); color: var(--text); border-color: var(--primary); box-shadow: 0 0 0 0.25rem rgba(14, 165, 233, 0.25); }
    .form-select option { background: var(--surface); color: var(--text); }
    .form-label { color: var(--text); font-size: 14px; font-weight: 600; margin-bottom: 6px; }
    .btn-tambah { background: var(--primary); border: none; font-weight: 600; padding: 12px; border-radius: 10px; width: 100%; font-size: 16px; margin-top: 10px; transition: all 0.2s ease-in-out; }
    .btn-tambah:hover { background: var(--primary-dark); transform: translateY(-1px); }
    .top-links { position: absolute; top: 20px; right: 20px; }
    .top-links a { color: var(--subtle); text-decoration: none; font-size: 13px; padding: 6px 14px; border: 1px solid var(--border); border-radius: 8px; transition: all 0.2s; }
    .top-links a:hover { color: var(--primary); border-color: var(--primary); }
    .overlay { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.55); display: none; align-items: center; justify-content: center; z-index: 1000; padding: 20px; }
    .overlay.show { display: flex; }
    .overlay-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 35px 30px; max-width: 420px; width: 100%; text-align: center; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15); }
    .overlay-card h3 { color: var(--primary); font-weight: 700; margin-bottom: 8px; font-size: 22px; }
    .overlay-card p { color: var(--subtle); font-size: 14px; margin-bottom: 25px; }
    .overlay-card .continue-name { color: var(--primary); font-weight: 600; }
    .btn-continue { background: var(--primary); border: none; color: #fff; font-weight: 600; padding: 12px; border-radius: 10px; width: 100%; font-size: 15px; margin-bottom: 10px; transition: all 0.2s ease-in-out; }
    .btn-continue:hover { background: var(--primary-dark); transform: translateY(-1px); }
    .btn-new { background: var(--bg); border: 1px solid var(--border); color: var(--text); font-weight: 600; padding: 12px; border-radius: 10px; width: 100%; font-size: 15px; transition: all 0.2s ease-in-out; }
    .btn-new:hover { color: var(--primary); border-color: var(--primary); }

    @media (max-width: 576px) {
      body { padding: 12px; justify-content: flex-start; }
      .main-card { padding: 24px 18px; border-radius: 14px; box-shadow: none; }
      .main-card h3 { font-size: 20px; }
      .main-card p.subtitle { font-size: 13px; margin-bottom: 20px; }
      .form-label { font-size: 13px; }
      .form-control, .form-select { padding: 11px 12px; font-size: 16px; }
      .btn-tambah { padding: 13px; font-size: 15px; }
      .top-links { top: 12px; right: 12px; }
      .top-links a { font-size: 12px; padding: 5px 11px; }
      .overlay { padding: 15px; }
      .overlay-card { padding: 26px 18px; border-radius: 14px; }
      .overlay-card h3 { font-size: 19px; }
      .overlay-card p { font-size: 13px; }
      .btn-continue, .btn-new { padding: 12px; font-size: 14px; }
    }
  </style>
</head>
<body>
  <div class="overlay" id="resumeOverlay">
    <div class="overlay-card">
      <h3>Selamat Datang Kembali!</h3>
      <p>Anda memiliki percakapan sebelumnya dengan nama <span class="continue-name" id="continueName"></span>. Lanjutkan chat atau mulai baru?</p>
      <button id="btnContinue" class="btn-continue">Lanjutkan Chat</button>
      <button id="btnNew" class="btn-new">Mulai Baru</button>
    </div>
  </div>
  <div class="top-links">
    <a href="/admin">Admin Panel</a>
  </div>
  <div class="main-card">
    <h3><%= title %></h3>
    <p class="subtitle">Silakan isi data Anda untuk memulai percakapan</p>

    <form action="/tambah" method="post">
      <div class="mb-3">
        <label class="form-label">Nama Lengkap</label>
        <input type="text" name="nama" class="form-control" placeholder="Masukkan nama lengkap" required />
      </div>
      <div class="mb-3">
        <label class="form-label">Alamat</label>
        <textarea name="alamat" class="form-control" rows="2" placeholder="Masukkan alamat lengkap" required></textarea>
      </div>
      <div class="mb-3">
        <label class="form-label">Nomor WhatsApp</label>
        <input type="tel" name="nomor_wa" class="form-control" placeholder="Contoh: 081234567890" pattern="[0-9+\-() ]*" inputmode="numeric" required />
      </div>
      <div class="mb-4">
        <label class="form-label">Rumah Sakit Tujuan</label>
        <select name="rumah_sakit" class="form-select" required>
          <option value="" disabled selected>Pilih Rumah Sakit</option>
          <% rumahSakitList.forEach(rs => { %>
            <option value="<%= rs %>"><%= rs %></option>
          <% }) %>
        </select>
      </div>
      <button type="submit" class="btn btn-tambah">Masuk Chat</button>
    </form>
  </div>

  <script>
    (function () {
      const SESSION_KEY = 'dinkes_chat_session';
      const overlay = document.getElementById('resumeOverlay');

      const raw = localStorage.getItem(SESSION_KEY);
      if (!raw) return;

      let session;
      try { session = JSON.parse(raw); } catch (e) { return; }
      if (!session || !session.roomId) return;

      // Pastikan chat pasien masih ada sebelum menampilkan overlay
      fetch('/api/patient-exists/' + encodeURIComponent(session.roomId))
        .then((r) => r.json())
        .then((data) => {
          if (data && data.exists === true) {
            document.getElementById('continueName').textContent = session.userName || session.roomId;
            overlay.classList.add('show');
          } else {
            localStorage.removeItem(SESSION_KEY);
          }
        })
        .catch(() => {});

      document.getElementById('btnContinue').addEventListener('click', () => {
        window.location.href = '/chat/' + encodeURIComponent(session.roomId);
      });

      document.getElementById('btnNew').addEventListener('click', () => {
        localStorage.removeItem(SESSION_KEY);
        overlay.classList.remove('show');
      });
    })();
  </script>
</body>
</html>
