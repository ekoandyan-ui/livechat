<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Chat Room - <%= userName %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    :root {
      --primary: #0ea5e9;
      --primary-dark: #0284c7;
      --primary-light: #e0f2fe;
      --bg: #f8fafc;
      --surface: #ffffff;
      --text: #0f172a;
      --subtle: #64748b;
      --border: rgba(0, 0, 0, 0.1);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: var(--bg); color: var(--text); font-family: 'Segoe UI', sans-serif; height: 100vh; height: 100dvh; overflow: hidden; }
    .chat-header { background: var(--surface); padding: 15px 25px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; position: fixed; top: 0; left: 0; right: 0; z-index: 10; }
    .chat-header h5 { margin: 0; }
    .chat-header .room-label { color: var(--subtle); font-size: 13px; }
    .chat-header .hospital-tag { color: var(--primary); font-size: 12px; font-weight: 600; background: var(--primary-light); padding: 4px 10px; border-radius: 8px; margin-top: 4px; display: inline-block; }
    .online-badge { background: #27ae60; color: #fff; font-size: 12px; padding: 3px 10px; border-radius: 20px; }
    .chat-messages { position: fixed; left: 0; right: 0; overflow-y: auto; -webkit-overflow-scrolling: touch; padding: 20px 25px; }
    .msg { margin-bottom: 15px; }
    .msg-mine { margin-left: auto; margin-right: 0; }
    .msg .msg-bubble { padding: 10px 15px; border-radius: 12px; font-size: 14px; line-height: 1.5; word-wrap: break-word; display: inline-block; width: fit-content; min-width: 40%; max-width: 90%; }
    .msg-mine .msg-bubble { background: var(--primary); color: #fff; border-bottom-right-radius: 4px; }
    .msg-other .msg-bubble { background: var(--surface); color: var(--text); border: 1px solid var(--border); border-bottom-left-radius: 4px; }
    .msg .msg-meta { font-size: 11px; color: var(--subtle); margin-top: 4px; }
    .msg-mine .msg-meta { text-align: right; }
    .no-msg { text-align: center; color: var(--subtle); padding: 60px 20px; font-size: 14px; }
    .chat-input { background: var(--surface); padding: 15px 25px; border-top: 1px solid var(--border); display: flex; gap: 10px; position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; }
    .chat-input input { flex: 1; background: var(--bg); border: 1px solid var(--border); color: var(--text); padding: 12px 15px; border-radius: 8px; font-size: 14px; }
    .chat-input input:focus { outline: none; border-color: var(--primary); }
    .chat-input button { background: var(--primary); border: none; color: #fff; padding: 12px 25px; border-radius: 8px; font-weight: 600; cursor: pointer; }
    .chat-input button:hover { background: var(--primary-dark); }
    .admin-msg { border-left: 3px solid var(--primary); }

    @media (max-width: 768px) {
      .chat-header { padding: 12px 15px; gap: 8px; }
      .chat-header h5 { font-size: 16px; }
      .chat-messages { padding: 15px; }
      .msg { }
      .chat-input { padding: 12px 15px; }
      .chat-input input { padding: 11px 12px; font-size: 13px; }
      .chat-input button { padding: 11px 18px; }
    }

    @media (max-width: 576px) {
      .chat-header { padding: 10px 12px; align-items: flex-start; }
      .chat-header h5 { font-size: 15px; }
      .chat-header .room-label { font-size: 11px; word-break: break-word; }
      .chat-header .hospital-tag { font-size: 11px; padding: 3px 8px; margin-top: 3px; }
      .online-badge { font-size: 11px; padding: 3px 8px; }
      .chat-messages { padding: 12px; }
      .msg { margin-bottom: 12px; }
      .msg .msg-bubble { padding: 9px 12px; font-size: 14px; }
      .msg .msg-meta { font-size: 10px; }
      .chat-input { padding: 10px 12px; gap: 8px; }
      .chat-input input { padding: 11px 12px; font-size: 16px; }
      .chat-input button { padding: 11px 16px; font-size: 14px; }
      .no-msg { padding: 40px 15px; font-size: 13px; }
    }
  </style>
</head>
<body>
  <div class="chat-header">
    <div>
      <h5><%= rumahSakit %></h5>
    </div>
  </div>

  <div class="chat-messages" id="chatMessages">
    <% if (messages.length === 0) { %>
      <div class="no-msg">Belum ada pesan. Mulai percakapan!</div>
    <% } else { %>
      <% messages.forEach(msg => { %>
        <div class="msg <%= msg.sender_name === userName ? 'msg-mine' : 'msg-other' %>" data-id="<%= msg.id %>">
          <div class="msg-bubble">
            <% if (msg.message_type === 'file') { %>
              <div class="chat-file">
                <% var fm = (msg.file_mime || '').toLowerCase(); %>
                <% if (fm.indexOf('image/') === 0) { %>
                  <img class="chat-file-img" src="/api/file/<%= msg.id %>" alt="<%= msg.file_name %>" onclick="window.open('/api/file/<%= msg.id %>','_blank')" />
                <% } else if (fm.indexOf('video/') === 0) { %>
                  <video class="chat-file-video" controls preload="metadata" src="/api/file/<%= msg.id %>"></video>
                <% } else { %>
                  <a class="chat-file-doc" href="/api/file/<%= msg.id %>" target="_blank">
                    <span class="doc-icon">📄</span>
                    <span class="doc-meta">
                      <span class="doc-name"><%= msg.file_name || 'Dokumen' %></span>
                      <span class="doc-size"><%= msg.file_size ? (msg.file_size / 1024).toFixed(1) : '0' %> KB</span>
                    </span>
                  </a>
                <% } %>
              </div>
            <% } else { %>
              <%= msg.message %>
            <% } %>
          </div>
          <div class="msg-meta">
            <%= new Date(msg.created_at).toLocaleString('id-ID', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' }) %>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>

  <div class="chat-input">
    <%- include('partials/chat-tools', { senderName: userName, roomId: roomId, placeholder: 'Ketik pesan...' }) %>
    <button id="sendBtn">Kirim</button>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    const socket = io();
    const roomId = '<%= roomId %>';
    const myName = '<%= userName %>';
    const myAlamat = '<%= alamat %>';
    const myNomorWa = '<%= nomorWa %>';
    const myRumahSakit = '<%= rumahSakit %>';
    const chatMessages = document.getElementById('chatMessages');
    const msgInput = document.getElementById('msgInput');
    const sendBtn = document.getElementById('sendBtn');

    // Fix: input chat selalu menyesuaikan tepat di atas keyboard HP (semua browser)
    const headerEl = document.querySelector('.chat-header');
    const inputEl = document.querySelector('.chat-input');
    function updateChatLayout() {
      let gap = 0;
      if (window.visualViewport) {
        const vv = window.visualViewport;
        gap = Math.max(0, window.innerHeight - (vv.offsetTop + vv.height));
      }
      inputEl.style.bottom = gap + 'px';
      chatMessages.style.top = headerEl.offsetHeight + 'px';
      chatMessages.style.bottom = (inputEl.offsetHeight + gap) + 'px';
    }
    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', () => { updateChatLayout(); scrollToBottom(); });
      window.visualViewport.addEventListener('scroll', () => { updateChatLayout(); scrollToBottom(); });
    }
    window.addEventListener('resize', () => { updateChatLayout(); scrollToBottom(); });
    updateChatLayout();

    const SESSION_KEY = 'dinkes_chat_session';

    // Simpan data chat pasien agar tetap tersimpan saat refresh/keluar browser
    function saveSession() {
      const data = {
        roomId,
        userName: myName,
        alamat: myAlamat,
        nomorWa: myNomorWa,
        rumahSakit: myRumahSakit,
        savedAt: Date.now(),
      };
      localStorage.setItem(SESSION_KEY, JSON.stringify(data));
    }
    saveSession();

    // Jika admin menghapus total chat, otomatis kembali ke form pendaftaran
    function handleChatDeleted() {
      localStorage.removeItem(SESSION_KEY);
      window.location.href = '/';
    }

    socket.on('chat-deleted', handleChatDeleted);

    // Pengecekan berkala: jika pasien dihapus saat socket tidak tersambung
    setInterval(async () => {
      try {
        const res = await fetch('/api/patient-exists/' + encodeURIComponent(roomId));
        const data = await res.json();
        if (data && data.exists === false) handleChatDeleted();
      } catch (err) {}
    }, 20000);

    socket.emit('join-room', roomId);

    function scrollToBottom() {
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }
    scrollToBottom();

    function formatTime(dateStr) {
      const d = new Date(dateStr);
      return d.toLocaleString('id-ID', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' });
    }

    function appendMessage(data) {
      const noMsg = chatMessages.querySelector('.no-msg');
      if (noMsg) noMsg.remove();

      const isMine = data.sender_name === myName;
      const div = document.createElement('div');
      div.className = 'msg ' + (isMine ? 'msg-mine' : 'msg-other');
      div.dataset.id = data.id;
      div.innerHTML = `
        <div class="msg-bubble">
          ${window.renderChatAttachmentBody(data)}
        </div>
        <div class="msg-meta">
          ${formatTime(data.created_at)}
        </div>
      `;
      chatMessages.appendChild(div);
      scrollToBottom();
    }

    sendBtn.addEventListener('click', () => {
      const msg = msgInput.value.trim();
      if (!msg) return;
      socket.emit('message', { roomId, senderName: myName, message: msg });
      msgInput.value = '';
    });

    msgInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') sendBtn.click();
    });

    socket.on('room-message', (data) => {
      if (data.room_id === roomId) {
        const exists = chatMessages.querySelector(`[data-id="${data.id}"]`);
        if (!exists) appendMessage(data);
      }
    });
  </script>
</body>
</html>
