<%- include('partials/admin-auth-head', { title: 'Kode Pemulihan MFA' }) %>
    <h2>KODE PEMULIHAN</h2>
    <p class="subtitle">Simpan kode ini di tempat aman. Setiap kode hanya bisa dipakai sekali.</p>
    <div style="background:#fef9c3;border:1px solid #fde047;padding:10px;border-radius:8px;font-size:12px;margin-bottom:12px">
      Kode ini <strong>TIDAK</strong> akan ditampilkan lagi. Tanpa kode pemulihan,
      kehilangan perangkat dapat mengunci akun Anda.
    </div>
    <ul style="list-style:none;padding:0;font-family:monospace;font-size:14px;margin-bottom:16px">
      <% codes.forEach(function (c) { %>
        <li style="padding:6px 0;border-bottom:1px dashed var(--border)"><%= c %></li>
      <% }) %>
    </ul>
    <a class="btn btn-login" href="<%= next %>" style="display:block;text-align:center;text-decoration:none">
      SAYA SUDAH MENYIMPAN
    </a>
<%- include('partials/admin-auth-foot') %>
