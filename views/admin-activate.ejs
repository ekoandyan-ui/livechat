<%- include('partials/admin-auth-head', { title: 'Aktivasi Akun' }) %>
    <h2>AKTIVASI AKUN</h2>
    <p class="subtitle">Tetapkan password untuk akun Anda</p>
    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>
    <% if (email) { %>
      <div class="alert alert-info" style="font-size:13px">Akun: <b><%= email %></b><% if (rumahSakit) { %> (<%= rumahSakit %>)<% } %></div>
    <% } %>
    <form method="POST" action="/admin/activate">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="token" value="<%= token %>" />
      <%- include('partials/password-field', { name: 'password', id: 'pw1', label: 'Password Baru', autocomplete: 'new-password', placeholder: 'Minimal 12 karakter', hint: 'Minimal 12 karakter. Hindari password umum atau sama dengan email.' }) %>
      <%- include('partials/password-field', { name: 'password2', id: 'pw2', label: 'Ulangi Password', autocomplete: 'new-password', placeholder: 'Ulangi password' }) %>
      <button type="submit" class="btn btn-login">AKTIVASI</button>
    </form>
<%- include('partials/admin-auth-foot') %>
