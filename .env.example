# Salin file ini menjadi .env dan isi nilainya.
# JANGAN pernah commit file .env ke git.

# Koneksi database Supabase/PostgreSQL
DATABASE_URL=postgres://user:password@host:5432/database

# Secret session (WAJIB diisi & random saat production, mis. 32+ karakter acak)
# Contoh generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# =1 untuk memaksa cookie secure (hanya HTTPS). Default: aktif saat NODE_ENV=production
# COOKIE_SECURE=1

# Redis untuk session store & rate-limit (WAJIB untuk production / multi-instance).
# Contoh: redis://default:password@host:6379
# REDIS_URL=redis://localhost:6379

# Aktifkan endpoint /test-db (default OFF, dan selalu OFF saat production).
# ALLOW_TEST_DB=true

# Origin publik aplikasi (WAJIB di production, HTTPS). Dipakai untuk membuat
# tautan aktivasi/reset password. Jangan andalkan header Host dari request.
# APP_BASE_URL=https://chat.example.com

# --- SMTP untuk email transaksional (aktivasi / reset / notifikasi) ---
# Jika SMTP_HOST kosong, email tidak dikirim (di mode dev password/tautan dicetak ke console).
#
# Gmail + App Password:
#   1) Aktifkan 2-Step Verification pada akun Google.
#   2) Buat App Password: https://myaccount.google.com/apppasswords
#   3) Isi SMTP_USER dengan alamat Gmail, SMTP_PASS dengan 16 karakter App Password (tanpa spasi).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=ekoandyan@gmail.com
# SMTP_PASS=xumbmbizmiphvcdl
# MAIL_FROM="Live Chat Dinkes <ekoandyan@gmail.com>"
# APP_BASE_URL=http://localhost:8000

# --- WEB PUSH (VAPID) untuk notifikasi pesan baru saat web ditutup ---
# Generate pasangan kunci: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Simpan private key HANYA sebagai secret environment; jangan commit ke git.
# Wajib HTTPS di produksi (localhost diizinkan untuk pengembangan).
# VAPID_PUBLIC_KEY=BC5D0rtKTyp9etBuKE46mbXPrTQwkrd9X7cEMxIcxa24SyqPV3yAnoFyWtTQsG3SHNcyfOYq7HAe3Gb3kdsxF8E
# VAPID_PRIVATE_KEY=L2i2knU-4yvynMIQ4CbwWQxK6BJ9n7K6GvgWRgR-Pec
# VAPID_SUBJECT=mailto:ekoandyan@gmail.com

# Port server (default 8000)
# PORT=8000