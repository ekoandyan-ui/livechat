# Salin file ini menjadi .env dan isi nilainya.
# JANGAN pernah commit file .env ke git.

# Koneksi database Supabase/PostgreSQL
DATABASE_URL=postgres://user:password@host:5432/database

# Opsional: lokasi file daftar admin untuk seeder (node database/seed-admins.js).
# Bila kosong, seeder memakai database/admins.seed.json (lihat admins.seed.example.json).
# Alternatif: ADMIN_SEED_JSON='[{"username":"...","email":"...","role":"super_admin"}]'
# ADMIN_SEED_FILE=database/admins.seed.json

# Secret session (WAJIB diisi & random saat production, mis. 32+ karakter acak)
# Contoh generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# =1 untuk memaksa cookie secure (hanya HTTPS). Default: aktif saat NODE_ENV=production
# COOKIE_SECURE=1

# Redis untuk session store & rate-limit (WAJIB untuk production / multi-instance).
# Contoh: redis://default:password@host:6379
# REDIS_URL=redis://localhost:6379

# Aktifkan endpoint /test-db (default OFF, dan selalu OFF saat production).
# ALLOW_TEST_DB=true

# Origin publik aplikasi (WAJIB di production, HTTPS). Dipakai untuk membuat
# tautan aktivasi/reset password. Jangan andalkan header Host dari request.
# APP_BASE_URL=https://chat.example.com

# --- SMTP untuk email transaksional (aktivasi / reset / notifikasi) ---
# Jika SMTP_HOST kosong, email tidak dikirim (di mode dev password/tautan dicetak ke console).
#
# Gmail + App Password:
#   1) Aktifkan 2-Step Verification pada akun Google.
#   2) Buat App Password: https://myaccount.google.com/apppasswords
#   3) Isi SMTP_USER dengan alamat Gmail, SMTP_PASS dengan 16 karakter App Password (tanpa spasi).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true untuk port 465
# SMTP_USER=namagmail@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop   # App Password (16 karakter)
# MAIL_FROM="Live Chat <namagmail@gmail.com>"   # opsional; default = SMTP_USER

# --- NOTIFIKASI EMAIL PESAN BARU ---
# Dikirim hanya bila penerima (pasien/admin) sedang tidak membuka aplikasi.
# Isi email generik + tautan; tidak memuat data pasien.
# EMAIL_NOTIFY_ENABLED=true
# EMAIL_NOTIFY_DELAY_SECONDS=90        # jeda sebelum kirim (gabung pesan beruntun)
# EMAIL_WORKER_INTERVAL_SECONDS=20     # interval worker memeriksa outbox
# EMAIL_MAX_PER_HOUR=6                 # batas email per penerima per jam
# EMAIL_MAX_ATTEMPTS=5                 # percobaan kirim sebelum status failed
# EMAIL_RETENTION_DAYS=30              # retensi baris outbox lama
# EMAIL_NOTIFY_URL=https://livechat.demakkab.go.id   # default: URL produksi di atas
# EMAIL_DRY_RUN=1                      # staging: tandai terkirim tanpa SMTP

# --- WEB PUSH (VAPID) untuk notifikasi pesan baru saat web ditutup ---
# Generate pasangan kunci: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Simpan private key HANYA sebagai secret environment; jangan commit ke git.
# Wajib HTTPS di produksi (localhost diizinkan untuk pengembangan).
# VAPID_PUBLIC_KEY=isi-public-key
# VAPID_PRIVATE_KEY=isi-private-key
# VAPID_SUBJECT=mailto:admin@example.com

# Port server (default 8000)
# PORT=8000